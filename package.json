{
  "name": "prereview",
  "displayName": "Prereview",
  "description": "Review your coding agent's changes like a GitHub pull request, locally in your editor.",
  "version": "0.1.0",
  "publisher": "marischn",
  "license": "MIT",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MariSchn/Prereview.git"
  },
  "homepage": "https://github.com/MariSchn/Prereview#readme",
  "bugs": {
    "url": "https://github.com/MariSchn/Prereview/issues"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "SCM Providers"
  ],
  "keywords": [
    "code review",
    "pull request",
    "ai agent",
    "claude code",
    "codex",
    "cursor",
    "diff",
    "git",
    "worktree",
    "comments"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Prereview runs git and reads review files in the workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Prereview needs a local git repository."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prereview",
          "title": "Prereview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "prereview": [
        {
          "id": "prereview.reviews",
          "name": "Reviews",
          "initialSize": 1
        },
        {
          "id": "prereview.files",
          "name": "Changed Files",
          "initialSize": 3
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "prereview.reviews",
        "contents": "No reviews yet.\n[Start Review](command:prereview.startReview)"
      },
      {
        "view": "prereview.files",
        "when": "!prereview.active",
        "contents": "No active review. Pick one under Reviews or start a new one."
      },
      {
        "view": "prereview.files",
        "when": "prereview.noChanges",
        "contents": "No changes in this review.\nThe two sides match, so there is nothing to comment on yet.\n[Open Overview](command:prereview.openOverview)\n[$(refresh) Refresh](command:prereview.refresh)"
      }
    ],
    "commands": [
      {
        "command": "prereview.startReview",
        "title": "Open or Start Review…",
        "category": "Prereview",
        "icon": "$(add)"
      },
      {
        "command": "prereview.switchReview",
        "title": "Open Review"
      },
      {
        "command": "prereview.openOverview",
        "title": "Open Overview",
        "category": "Prereview",
        "icon": "$(preview)"
      },
      {
        "command": "prereview.openAllChanges",
        "title": "Open All Changes",
        "category": "Prereview",
        "icon": "$(git-compare)"
      },
      {
        "command": "prereview.copyReviewPath",
        "title": "Copy Review Path",
        "category": "Prereview",
        "icon": "$(copy)"
      },
      {
        "command": "prereview.refresh",
        "title": "Refresh",
        "category": "Prereview",
        "icon": "$(refresh)"
      },
      {
        "command": "prereview.finishReview",
        "title": "Finish Review…",
        "category": "Prereview",
        "icon": "$(pass)"
      },
      {
        "command": "prereview.markViewed",
        "title": "Mark as Viewed",
        "category": "Prereview",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "prereview.markUnviewed",
        "title": "Mark as Unviewed",
        "category": "Prereview",
        "icon": "$(pass-filled)"
      },
      {
        "command": "prereview.openSinceViewed",
        "title": "Open Changes Since Viewed",
        "category": "Prereview",
        "icon": "$(history)"
      },
      {
        "command": "prereview.openDiff",
        "title": "Open Diff"
      },
      {
        "command": "prereview.createThread",
        "title": "Comment"
      },
      {
        "command": "prereview.reply",
        "title": "Reply"
      },
      {
        "command": "prereview.resolve",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "prereview.unresolve",
        "title": "Reopen",
        "icon": "$(discard)"
      },
      {
        "command": "prereview.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "prereview.saveComment",
        "title": "Save"
      },
      {
        "command": "prereview.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "prereview.deleteComment",
        "title": "Delete",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "prereview.startReview",
          "when": "view == prereview.reviews",
          "group": "navigation"
        },
        {
          "command": "prereview.openOverview",
          "when": "view == prereview.files && prereview.active",
          "group": "navigation@1"
        },
        {
          "command": "prereview.openAllChanges",
          "when": "view == prereview.files && prereview.active && !prereview.noChanges",
          "group": "navigation@2"
        },
        {
          "command": "prereview.copyReviewPath",
          "when": "view == prereview.files && prereview.active",
          "group": "navigation@3"
        },
        {
          "command": "prereview.startReview",
          "when": "view == prereview.files",
          "group": "1_review@1"
        },
        {
          "command": "prereview.refresh",
          "when": "view == prereview.files && prereview.active",
          "group": "1_review@2"
        },
        {
          "command": "prereview.finishReview",
          "when": "view == prereview.files && prereview.active",
          "group": "1_review@3"
        }
      ],
      "view/item/context": [
        {
          "command": "prereview.copyReviewPath",
          "when": "view == prereview.reviews && viewItem == review",
          "group": "inline@1"
        },
        {
          "command": "prereview.finishReview",
          "when": "view == prereview.reviews && viewItem == review",
          "group": "inline@2"
        },
        {
          "command": "prereview.openSinceViewed",
          "when": "view == prereview.files && viewItem == file-updated",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "prereview.markViewed",
          "when": "prereview.activeFile == unviewed",
          "group": "navigation"
        },
        {
          "command": "prereview.markUnviewed",
          "when": "prereview.activeFile == viewed",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "prereview.createThread",
          "group": "inline",
          "when": "commentController == prereview && commentThreadIsEmpty && !commentIsEmpty"
        },
        {
          "command": "prereview.reply",
          "group": "inline",
          "when": "commentController == prereview && !commentThreadIsEmpty && !commentIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "prereview.resolve",
          "group": "inline",
          "when": "commentController == prereview && commentThread == unresolved"
        },
        {
          "command": "prereview.unresolve",
          "group": "inline",
          "when": "commentController == prereview && commentThread == resolved"
        }
      ],
      "comments/comment/title": [
        {
          "command": "prereview.editComment",
          "group": "inline@1",
          "when": "commentController == prereview && comment == reviewer"
        },
        {
          "command": "prereview.deleteComment",
          "group": "inline@2",
          "when": "commentController == prereview"
        }
      ],
      "comments/comment/context": [
        {
          "command": "prereview.cancelEdit",
          "group": "inline@1",
          "when": "commentController == prereview"
        },
        {
          "command": "prereview.saveComment",
          "group": "inline@2",
          "when": "commentController == prereview"
        }
      ],
      "commandPalette": [
        {
          "command": "prereview.switchReview",
          "when": "false"
        },
        {
          "command": "prereview.openDiff",
          "when": "false"
        },
        {
          "command": "prereview.createThread",
          "when": "false"
        },
        {
          "command": "prereview.reply",
          "when": "false"
        },
        {
          "command": "prereview.resolve",
          "when": "false"
        },
        {
          "command": "prereview.unresolve",
          "when": "false"
        },
        {
          "command": "prereview.editComment",
          "when": "false"
        },
        {
          "command": "prereview.saveComment",
          "when": "false"
        },
        {
          "command": "prereview.cancelEdit",
          "when": "false"
        },
        {
          "command": "prereview.deleteComment",
          "when": "false"
        },
        {
          "command": "prereview.openOverview",
          "when": "prereview.active"
        },
        {
          "command": "prereview.openAllChanges",
          "when": "prereview.active && !prereview.noChanges"
        },
        {
          "command": "prereview.copyReviewPath",
          "when": "prereview.active"
        },
        {
          "command": "prereview.refresh",
          "when": "prereview.active"
        },
        {
          "command": "prereview.finishReview",
          "when": "prereview.active"
        },
        {
          "command": "prereview.markViewed",
          "when": "prereview.activeFile == unviewed"
        },
        {
          "command": "prereview.markUnviewed",
          "when": "prereview.activeFile == viewed"
        },
        {
          "command": "prereview.openSinceViewed",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.99.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
