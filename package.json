{
  "name": "prereview",
  "displayName": "Prereview",
  "description": "Review your coding agent's changes like a GitHub pull request, locally in your editor.",
  "version": "0.1.0",
  "publisher": "marischn",
  "license": "MIT",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MariSchn/Prereview.git"
  },
  "homepage": "https://github.com/MariSchn/Prereview#readme",
  "bugs": {
    "url": "https://github.com/MariSchn/Prereview/issues"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "SCM Providers"
  ],
  "keywords": [
    "code review",
    "pull request",
    "ai agent",
    "claude code",
    "codex",
    "cursor",
    "diff",
    "git",
    "worktree",
    "comments"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:prereview",
    "onWebviewPanel:prereview.overview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Prereview runs git and reads review files in the workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Prereview needs a local git repository."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prereview",
          "title": "Prereview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "prereview": [
        {
          "id": "prereview.reviews",
          "name": "Reviews",
          "initialSize": 1
        },
        {
          "id": "prereview.files",
          "name": "Changed Files",
          "initialSize": 3
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "prereview.reviews",
        "when": "workbenchState == empty",
        "contents": "Open a folder in a git repository to review an agent's changes.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "prereview.reviews",
        "when": "prereview.noRepository",
        "contents": "This folder isn't in a git repository.\n[Initialize Repository](command:git.init)"
      },
      {
        "view": "prereview.reviews",
        "when": "workbenchState != empty && !prereview.noRepository",
        "contents": "No reviews yet.\n[Start Review](command:prereview.startReview)"
      },
      {
        "view": "prereview.files",
        "when": "!prereview.active",
        "contents": "No active review. Pick one under Reviews or start a new one."
      },
      {
        "view": "prereview.files",
        "when": "prereview.active && prereview.noChanges",
        "contents": "No changes in this review.\nThe two sides match, so there is nothing to comment on yet.\n[Open Overview](command:prereview.openOverview)\n[$(refresh) Refresh](command:prereview.refresh)"
      },
      {
        "view": "prereview.files",
        "when": "prereview.active && prereview.emptyDiff",
        "contents": "No file changes.\nComments are still open in the overview.\n[Open Overview](command:prereview.openOverview)\n[$(refresh) Refresh](command:prereview.refresh)"
      }
    ],
    "commands": [
      {
        "command": "prereview.startReview",
        "title": "Open or Start Review…",
        "category": "Prereview",
        "icon": "$(add)"
      },
      {
        "command": "prereview.switchReview",
        "title": "Open Review"
      },
      {
        "command": "prereview.reviewWorktree",
        "title": "Start Review"
      },
      {
        "command": "prereview.openOverview",
        "title": "Open Overview",
        "category": "Prereview",
        "icon": "$(preview)"
      },
      {
        "command": "prereview.openAllChanges",
        "title": "Open All Changes",
        "category": "Prereview",
        "icon": "$(git-compare)"
      },
      {
        "command": "prereview.copyReviewPath",
        "title": "Copy Review Path",
        "category": "Prereview",
        "icon": "$(copy)"
      },
      {
        "command": "prereview.copyReviewMarkdown",
        "title": "Copy Review as Markdown",
        "category": "Prereview",
        "icon": "$(markdown)"
      },
      {
        "command": "prereview.copyPrompt",
        "title": "Copy Prompt for Agent",
        "category": "Prereview",
        "icon": "$(copy)"
      },
      {
        "command": "prereview.sendToTerminal",
        "title": "Send to Agent Terminal",
        "category": "Prereview",
        "icon": "$(terminal)"
      },
      {
        "command": "prereview.copyReviewAgentPrompt",
        "title": "Copy Prompt for Review Agent",
        "category": "Prereview"
      },
      {
        "command": "prereview.sendToReviewAgentTerminal",
        "title": "Send to Review Agent Terminal",
        "category": "Prereview"
      },
      {
        "command": "prereview.markViewedAndNext",
        "title": "Mark as Viewed and Open Next File",
        "category": "Prereview",
        "icon": "$(check)"
      },
      {
        "command": "prereview.nextThread",
        "title": "Go to Next Open Thread",
        "category": "Prereview",
        "icon": "$(arrow-down)"
      },
      {
        "command": "prereview.previousThread",
        "title": "Go to Previous Open Thread",
        "category": "Prereview",
        "icon": "$(arrow-up)"
      },
      {
        "command": "prereview.openSinceHandoff",
        "title": "Open Changes Since Hand-Off",
        "category": "Prereview",
        "icon": "$(history)"
      },
      {
        "command": "prereview.openUnviewedChanges",
        "title": "Open Changes Not Yet Viewed",
        "category": "Prereview",
        "icon": "$(git-compare)"
      },
      {
        "command": "prereview.hideViewedFiles",
        "title": "Hide Viewed Files",
        "category": "Prereview",
        "icon": "$(eye-closed)"
      },
      {
        "command": "prereview.showViewedFiles",
        "title": "Show Viewed Files",
        "category": "Prereview",
        "icon": "$(eye)"
      },
      {
        "command": "prereview.openSinceComment",
        "title": "Show Changes Since My Comment",
        "icon": "$(history)"
      },
      {
        "command": "prereview.applySuggestion",
        "title": "Apply Suggestion"
      },
      {
        "command": "prereview.openPath",
        "title": "Open Mentioned File"
      },
      {
        "command": "prereview.openReviewFile",
        "title": "Open Review File",
        "category": "Prereview",
        "icon": "$(go-to-file)"
      },
      {
        "command": "prereview.refresh",
        "title": "Refresh",
        "category": "Prereview",
        "icon": "$(refresh)"
      },
      {
        "command": "prereview.finishReview",
        "title": "Finish Review…",
        "category": "Prereview",
        "icon": "$(pass)"
      },
      {
        "command": "prereview.markViewed",
        "title": "Mark as Viewed",
        "category": "Prereview",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "prereview.markUnviewed",
        "title": "Mark as Unviewed",
        "category": "Prereview",
        "icon": "$(pass-filled)"
      },
      {
        "command": "prereview.openSinceViewed",
        "title": "Open Changes Since Viewed",
        "category": "Prereview",
        "icon": "$(history)"
      },
      {
        "command": "prereview.openAllSinceViewed",
        "title": "Open All Changes Since Viewed",
        "category": "Prereview",
        "icon": "$(history)"
      },
      {
        "command": "prereview.openDiff",
        "title": "Open Changes"
      },
      {
        "command": "prereview.openFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "prereview.copyFilePath",
        "title": "Copy Path"
      },
      {
        "command": "prereview.copyRelativeFilePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "prereview.revealInExplorer",
        "title": "Reveal in Explorer View"
      },
      {
        "command": "prereview.createThread",
        "title": "Comment"
      },
      {
        "command": "prereview.reply",
        "title": "Reply"
      },
      {
        "command": "prereview.replyAndResolve",
        "title": "Reply and Resolve"
      },
      {
        "command": "prereview.expandThread",
        "title": "Show Thread"
      },
      {
        "command": "prereview.resolve",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "prereview.unresolve",
        "title": "Reopen",
        "icon": "$(discard)"
      },
      {
        "command": "prereview.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "prereview.saveComment",
        "title": "Save"
      },
      {
        "command": "prereview.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "prereview.deleteComment",
        "title": "Delete",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "commentEditorFocused && commentController == prereview",
        "args": {
          "snippet": "**${1:$TM_SELECTED_TEXT}**$0"
        }
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "commentEditorFocused && commentController == prereview",
        "args": {
          "snippet": "_${1:$TM_SELECTED_TEXT}_$0"
        }
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "commentEditorFocused && commentController == prereview",
        "args": {
          "snippet": "`${1:$TM_SELECTED_TEXT}`$0"
        }
      },
      {
        "command": "prereview.markViewedAndNext",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "prereview.active && (resource in prereview.viewedDocuments || resource in prereview.unviewedDocuments || activeEditor == multiDiffEditor && prereview.activeFile)"
      },
      {
        "command": "prereview.nextThread",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "prereview.active"
      },
      {
        "command": "prereview.previousThread",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "prereview.active"
      }
    ],
    "colors": [
      {
        "id": "prereview.commentRangeBackground",
        "description": "Background of the lines a new comment will cover while several lines are selected in a review diff.",
        "defaults": {
          "dark": "#3794ff26",
          "light": "#0066bf1a",
          "highContrast": "#3794ff40",
          "highContrastLight": "#0066bf33"
        }
      },
      {
        "id": "prereview.collapsedThreadForeground",
        "description": "Color of the note after a line with a collapsed, resolved thread in a review diff.",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "prereview.startReview",
          "when": "view == prereview.reviews",
          "group": "navigation"
        },
        {
          "command": "prereview.openOverview",
          "when": "view == prereview.files && prereview.active",
          "group": "navigation@1"
        },
        {
          "command": "prereview.openAllChanges",
          "when": "view == prereview.files && prereview.active && !prereview.noFiles",
          "group": "navigation@2"
        },
        {
          "command": "prereview.openAllSinceViewed",
          "when": "view == prereview.files && prereview.hasUpdated",
          "group": "navigation@3"
        },
        {
          "command": "prereview.copyPrompt",
          "when": "view == prereview.files && prereview.active",
          "group": "navigation@4"
        },
        {
          "command": "prereview.startReview",
          "when": "view == prereview.files",
          "group": "1_review@1"
        },
        {
          "command": "prereview.refresh",
          "when": "view == prereview.files && prereview.active",
          "group": "1_review@2"
        },
        {
          "command": "prereview.finishReview",
          "when": "view == prereview.files && prereview.active",
          "group": "1_review@4"
        },
        {
          "command": "prereview.copyReviewMarkdown",
          "when": "view == prereview.files && prereview.active",
          "group": "1_review@3"
        },
        {
          "command": "prereview.sendToTerminal",
          "when": "view == prereview.files && prereview.active",
          "group": "navigation@5"
        },
        {
          "command": "prereview.openSinceHandoff",
          "when": "view == prereview.files && prereview.changedSinceHandoff",
          "group": "navigation@3"
        },
        {
          "command": "prereview.hideViewedFiles",
          "when": "view == prereview.files && prereview.active && !prereview.hidingViewed",
          "group": "navigation@6"
        },
        {
          "command": "prereview.showViewedFiles",
          "when": "view == prereview.files && prereview.active && prereview.hidingViewed",
          "group": "navigation@6"
        },
        {
          "command": "prereview.copyReviewPath",
          "when": "view == prereview.files && prereview.active",
          "group": "1_review@3"
        },
        {
          "command": "prereview.openUnviewedChanges",
          "when": "view == prereview.files && prereview.active && !prereview.noFiles",
          "group": "1_review@1"
        },
        {
          "command": "prereview.copyReviewAgentPrompt",
          "when": "view == prereview.files && prereview.active",
          "group": "2_reviewAgent@1"
        },
        {
          "command": "prereview.sendToReviewAgentTerminal",
          "when": "view == prereview.files && prereview.active",
          "group": "2_reviewAgent@2"
        }
      ],
      "view/item/context": [
        {
          "command": "prereview.copyReviewPath",
          "when": "view == prereview.reviews && viewItem == review",
          "group": "inline@1"
        },
        {
          "command": "prereview.finishReview",
          "when": "view == prereview.reviews && viewItem == review",
          "group": "inline@2"
        },
        {
          "command": "prereview.openSinceViewed",
          "when": "view == prereview.files && viewItem == file-updated",
          "group": "inline"
        },
        {
          "command": "prereview.openFile",
          "when": "view == prereview.files && (viewItem == file || viewItem == file-updated)",
          "group": "inline@0"
        },
        {
          "command": "prereview.openDiff",
          "when": "view == prereview.files && viewItem =~ /^file/",
          "group": "1_open@1"
        },
        {
          "command": "prereview.openFile",
          "when": "view == prereview.files && (viewItem == file || viewItem == file-updated)",
          "group": "1_open@2"
        },
        {
          "command": "prereview.openSinceViewed",
          "when": "view == prereview.files && viewItem == file-updated",
          "group": "1_open@3"
        },
        {
          "command": "prereview.revealInExplorer",
          "when": "view == prereview.files && (viewItem == file || viewItem == file-updated)",
          "group": "2_reveal@1"
        },
        {
          "command": "prereview.copyFilePath",
          "when": "view == prereview.files && viewItem =~ /^file/",
          "group": "6_copypath@1"
        },
        {
          "command": "prereview.copyRelativeFilePath",
          "when": "view == prereview.files && viewItem =~ /^file/",
          "group": "6_copypath@2"
        },
        {
          "command": "prereview.switchReview",
          "when": "view == prereview.reviews && viewItem == review",
          "group": "1_open@1"
        },
        {
          "command": "prereview.openReviewFile",
          "when": "view == prereview.reviews && viewItem == review",
          "group": "1_open@2"
        },
        {
          "command": "prereview.copyReviewPath",
          "when": "view == prereview.reviews && viewItem == review",
          "group": "2_copy@1"
        },
        {
          "command": "prereview.finishReview",
          "when": "view == prereview.reviews && viewItem == review",
          "group": "3_finish@1"
        },
        {
          "command": "prereview.copyReviewMarkdown",
          "when": "view == prereview.reviews && viewItem == review",
          "group": "2_copy@2"
        }
      ],
      "editor/title": [
        {
          "command": "prereview.markViewed",
          "when": "resource in prereview.unviewedDocuments || activeEditor == multiDiffEditor && prereview.activeFile == unviewed",
          "group": "navigation"
        },
        {
          "command": "prereview.markUnviewed",
          "when": "resource in prereview.viewedDocuments || activeEditor == multiDiffEditor && prereview.activeFile == viewed",
          "group": "navigation"
        },
        {
          "command": "prereview.openSinceViewed",
          "when": "resource in prereview.updatedDocuments || activeEditor == multiDiffEditor && prereview.activeFileUpdated",
          "group": "navigation"
        },
        {
          "command": "prereview.markViewedAndNext",
          "when": "resource in prereview.unviewedDocuments || activeEditor == multiDiffEditor && prereview.activeFile == unviewed",
          "group": "1_prereview@1"
        },
        {
          "command": "prereview.nextThread",
          "when": "prereview.active && (resource in prereview.viewedDocuments || resource in prereview.unviewedDocuments || activeEditor == multiDiffEditor && prereview.activeFile)",
          "group": "1_prereview@2"
        },
        {
          "command": "prereview.previousThread",
          "when": "prereview.active && (resource in prereview.viewedDocuments || resource in prereview.unviewedDocuments || activeEditor == multiDiffEditor && prereview.activeFile)",
          "group": "1_prereview@3"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "prereview.createThread",
          "group": "inline",
          "when": "commentController == prereview && commentThreadIsEmpty && !commentIsEmpty"
        },
        {
          "command": "prereview.reply",
          "group": "inline@1",
          "when": "commentController == prereview && !commentThreadIsEmpty && !commentIsEmpty"
        },
        {
          "command": "prereview.replyAndResolve",
          "group": "inline@2",
          "when": "commentController == prereview && !commentThreadIsEmpty && !commentIsEmpty && commentThread == unresolved"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "prereview.openSinceComment",
          "group": "inline@0",
          "when": "commentController == prereview"
        },
        {
          "command": "prereview.resolve",
          "group": "inline",
          "when": "commentController == prereview && commentThread == unresolved"
        },
        {
          "command": "prereview.unresolve",
          "group": "inline",
          "when": "commentController == prereview && commentThread == resolved"
        }
      ],
      "comments/comment/title": [
        {
          "command": "prereview.editComment",
          "group": "inline@1",
          "when": "commentController == prereview && comment == reviewer"
        },
        {
          "command": "prereview.deleteComment",
          "group": "inline@2",
          "when": "commentController == prereview"
        }
      ],
      "comments/comment/context": [
        {
          "command": "prereview.saveComment",
          "group": "inline@1",
          "when": "commentController == prereview"
        },
        {
          "command": "prereview.cancelEdit",
          "group": "inline@2",
          "when": "commentController == prereview"
        }
      ],
      "commandPalette": [
        {
          "command": "prereview.openSinceComment",
          "when": "false"
        },
        {
          "command": "prereview.applySuggestion",
          "when": "false"
        },
        {
          "command": "prereview.openPath",
          "when": "false"
        },
        {
          "command": "prereview.reviewWorktree",
          "when": "false"
        },
        {
          "command": "prereview.revealInExplorer",
          "when": "false"
        },
        {
          "command": "prereview.copyRelativeFilePath",
          "when": "false"
        },
        {
          "command": "prereview.copyFilePath",
          "when": "false"
        },
        {
          "command": "prereview.openFile",
          "when": "false"
        },
        {
          "command": "prereview.switchReview",
          "when": "false"
        },
        {
          "command": "prereview.openDiff",
          "when": "false"
        },
        {
          "command": "prereview.createThread",
          "when": "false"
        },
        {
          "command": "prereview.reply",
          "when": "false"
        },
        {
          "command": "prereview.replyAndResolve",
          "when": "false"
        },
        {
          "command": "prereview.expandThread",
          "when": "false"
        },
        {
          "command": "prereview.resolve",
          "when": "false"
        },
        {
          "command": "prereview.unresolve",
          "when": "false"
        },
        {
          "command": "prereview.editComment",
          "when": "false"
        },
        {
          "command": "prereview.saveComment",
          "when": "false"
        },
        {
          "command": "prereview.cancelEdit",
          "when": "false"
        },
        {
          "command": "prereview.deleteComment",
          "when": "false"
        },
        {
          "command": "prereview.openOverview",
          "when": "prereview.active"
        },
        {
          "command": "prereview.openAllChanges",
          "when": "prereview.active && !prereview.noFiles"
        },
        {
          "command": "prereview.copyReviewPath",
          "when": "prereview.active"
        },
        {
          "command": "prereview.openReviewFile",
          "when": "prereview.active"
        },
        {
          "command": "prereview.refresh",
          "when": "prereview.active"
        },
        {
          "command": "prereview.finishReview",
          "when": "prereview.active"
        },
        {
          "command": "prereview.markViewed",
          "when": "resource in prereview.unviewedDocuments || activeEditor == multiDiffEditor && prereview.activeFile == unviewed"
        },
        {
          "command": "prereview.markUnviewed",
          "when": "resource in prereview.viewedDocuments || activeEditor == multiDiffEditor && prereview.activeFile == viewed"
        },
        {
          "command": "prereview.openSinceViewed",
          "when": "resource in prereview.updatedDocuments || activeEditor == multiDiffEditor && prereview.activeFileUpdated"
        },
        {
          "command": "prereview.openAllSinceViewed",
          "when": "prereview.hasUpdated"
        },
        {
          "command": "prereview.copyReviewMarkdown",
          "when": "prereview.active"
        },
        {
          "command": "prereview.copyPrompt",
          "when": "prereview.active"
        },
        {
          "command": "prereview.sendToTerminal",
          "when": "prereview.active"
        },
        {
          "command": "prereview.copyReviewAgentPrompt",
          "when": "prereview.active"
        },
        {
          "command": "prereview.sendToReviewAgentTerminal",
          "when": "prereview.active"
        },
        {
          "command": "prereview.nextThread",
          "when": "prereview.active"
        },
        {
          "command": "prereview.previousThread",
          "when": "prereview.active"
        },
        {
          "command": "prereview.openUnviewedChanges",
          "when": "prereview.active"
        },
        {
          "command": "prereview.markViewedAndNext",
          "when": "resource in prereview.unviewedDocuments || activeEditor == multiDiffEditor && prereview.activeFile == unviewed"
        },
        {
          "command": "prereview.openSinceHandoff",
          "when": "prereview.changedSinceHandoff"
        },
        {
          "command": "prereview.hideViewedFiles",
          "when": "prereview.active && !prereview.hidingViewed"
        },
        {
          "command": "prereview.showViewedFiles",
          "when": "prereview.active && prereview.hidingViewed"
        }
      ]
    },
    "configuration": {
      "title": "Prereview",
      "properties": {
        "prereview.agentPrompt": {
          "type": "string",
          "default": "Address the code review in ${path}. The file explains how to reply.",
